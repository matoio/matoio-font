feature pnum {
  sub [zero one two three four five six seven eight nine] by [zero.pnum one.pnum two.pnum three.pnum four.pnum five.pnum six.pnum seven.pnum eight.pnum nine.pnum];
} pnum;

feature tnum {
  sub [zero.pnum one.pnum two.pnum three.pnum four.pnum five.pnum six.pnum seven.pnum eight.pnum nine.pnum] by [zero one two three four five six seven eight nine];
} tnum;
